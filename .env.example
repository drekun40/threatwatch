# Copy this file to .env and fill in what you have. Never commit or share .env.
# After editing, run:  python run.py selftest

# ---- Free, no key needed: Google News/local RSS, NWS alerts, Open Data Buffalo, ADS-B aircraft
# Optional: a Socrata app token raises Open Data rate limits (data.buffalony.gov > sign up > app tokens)
SOCRATA_APP_TOKEN=

# ---- 511NY traffic events — free: https://511ny.org/developers (register, key is emailed)
NY511_API_KEY=

# ---- Ticketmaster Discovery API (venue events) — free: https://developer.ticketmaster.com (My Apps > Consumer Key)
TICKETMASTER_API_KEY=

# ---- YouTube Data API v3 — free: console.cloud.google.com > APIs & Services > enable "YouTube Data API v3" > Credentials > API key
YOUTUBE_API_KEY=

# ---- AIS vessels — free: https://aisstream.io (sign in with GitHub > API Keys)
AISSTREAM_API_KEY=

# ---- Telegram — free: https://my.telegram.org > API development tools. Then: python run.py telegram-login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Bluesky — Settings > Privacy and security > App passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# ---- Reddit (after approval under Reddit's Responsible Builder Policy)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ThreatWatch/0.1 by u/yourusername

# ---- X API (pay-per-use) — later
X_BEARER_TOKEN=

# ---- Alerts: any of teams, email, console (comma-separated)
# Add ",email" or ",teams" once those are filled in below, e.g. ALERT_CHANNELS=console,email
ALERT_CHANNELS=console

# Teams: channel ... > Workflows > "Send webhook alerts to a channel". Paste the URL here.
TEAMS_WEBHOOK_URL=

# Email (Gmail: smtp.gmail.com, port 587, with an App Password — not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Summary email after every scan (needs "email" in ALERT_CHANNELS and the SMTP fields above).
# 1 = on (default), 0 = off. Act now/Alert items are still emailed on their own as they happen.
SCAN_SUMMARY_EMAIL=1
